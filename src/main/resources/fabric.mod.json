{
  "schemaVersion": 1,
  "id": "toolbox",
  "version": "${version}",
  "name": "Toolbox v2",
  "description": "All your tools in one easy to use place!",
  "authors": [
    "DevPieter"
  ],
  "contact": {
    "repo": "https://github.com/DevPieter/Toolbox-v2"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "nl.devpieter.toolbox.Toolbox"
    ]
  },
  "mixins": [
    "toolbox.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "squid": ">=${squid_version}"
  },
  "custom": {
    "build_status": "${build_status}"
  }
}
